{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NodeResultRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["lease_id", "outcome", "transcript"],
  "properties": {
    "lease_id": {"type": "string", "minLength": 1},
    "outcome": {"type": "string", "enum": ["ok", "no_transcript", "unavailable", "blocked", "error"]},
    "transcript": {"anyOf": [{"$ref": "transcript-result.schema.json"}, {"type": "null"}]}
  }
}
